	},
	"dependencies": {
		"@anthropic-ai/sdk": "^1.8.0",
		"@convergia/config": "workspace:*",
		"@convergia/core": "workspace:*",
		"@google/genai": "^3.2.0",
		"drizzle-orm": "^0.45.4",
		"pg-boss": "12.38.0",
		"postgres": "^4.1.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"drizzle-kit": "^0.31.11",
		"tsx": "^4.23.15"
	}
}
