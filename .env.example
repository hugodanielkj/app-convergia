# Copie para .env e ajuste. O .env nunca é versionado.
# Toda variável daqui existe também no schema de packages/config/src/env.ts.

# development | test | production
NODE_ENV=development

# Porta do servidor MCP
PORT=3000

# Postgres local do docker-compose.yml, publicado na porta 54320 para não colidir
# com um Postgres já instalado na máquina. Credenciais só de desenvolvimento.
DATABASE_URL=postgres://convergia:convergia@localhost:54320/convergia

# Chave da API da Anthropic para gerar e refinar roteiros. Obrigatória em produção.
# Vazia em desenvolvimento: o servidor usa o Gemini (se houver GEMINI_API_KEY) ou uma IA simulada.
ANTHROPIC_API_KEY=

# Só para testar fora de produção sem gastar: chave gratuita do Gemini (aistudio.google.com).
# O plano gratuito usa o conteúdo para melhorar os produtos do Google: não use dados reais.
GEMINI_API_KEY=
# Opcional. Padrão: gemini-3.5-flash-lite.
GEMINI_MODEL=

# Descoberta de vídeos do Instagram Reels e do TikTok (RN-110 a RN-119), pelo ScrapeCreators.
# Crie a chave em app.scrapecreators.com. Vazia: a tela avisa que a busca não está configurada
# e nenhum vídeo é mostrado. Cada pesquisa nova gasta até VIDEO_SEARCH_MAX_CALLS créditos.
SCRAPECREATORS_API_KEY=
# Opcionais. Vazias usam o padrão indicado.
# Validade do cache de cada pesquisa, em horas (padrão 6).
VIDEO_SEARCH_CACHE_TTL_HOURS=
# Pesquisas que coletam dados novos, por usuário: por dia (padrão 20) e por minuto (padrão 5).
VIDEO_SEARCH_DAILY_LIMIT_PER_USER=
VIDEO_SEARCH_PER_MINUTE_LIMIT=
# Chamadas ao provedor por pesquisa (padrão 8) e quantos Reels têm as visualizações buscadas
# uma a uma (padrão 5; cada uma conta nas chamadas).
VIDEO_SEARCH_MAX_CALLS=
VIDEO_SEARCH_METRIC_REFRESH=
# Tempo máximo de cada chamada ao provedor, em ms (padrão 20000).
VIDEO_SEARCH_TIMEOUT_MS=
# true ou false: a IA sugere até 2 variações da pesquisa (padrão true).
VIDEO_SEARCH_AI_EXPANSION=
