# Copie para .env e ajuste. O .env nunca é versionado.
# Toda variável daqui existe também no schema de packages/config/src/env.ts.

# development | test | production
NODE_ENV=development

# Porta do servidor MCP
PORT=3000

# Postgres local do docker-compose.yml, publicado na porta 54320 para não colidir
# com um Postgres já instalado na máquina. Credenciais só de desenvolvimento.
DATABASE_URL=postgres://convergia:convergia@localhost:54320/convergia
