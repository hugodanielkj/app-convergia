{
	"name": "convergia",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.23.0",
	"engines": {
		"node": ">=26 <27"
	},
	"scripts": {
		"dev": "pnpm --filter @convergia/server dev",
		"db:generate": "pnpm --filter @convergia/infra db:generate",
		"db:migrate": "pnpm --filter @convergia/infra db:migrate",
		"db:seed": "pnpm --filter @convergia/infra db:seed",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "pnpm -r run typecheck",
		"test": "vitest run --project unit",
		"test:integration": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --project integration"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@types/node": "^26.6.6",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	}
}
